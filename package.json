{
  "name": "@driftee/dstjs",
  "version": "0.2.0",
  "description": "A TypeScript toolkit for parsing, extracting, converting, and rendering Don't Starve Together assets.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@10.6.4",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "NOTICE.md",
    "third_party"
  ],
  "bin": {
    "dst": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./atlas": {
      "types": "./dist/atlas/index.d.ts",
      "default": "./dist/atlas/index.js"
    },
    "./animation": {
      "types": "./dist/animation/index.d.ts",
      "default": "./dist/animation/index.js"
    },
    "./cooking": {
      "types": "./dist/cooking/index.d.ts",
      "default": "./dist/cooking/index.js"
    },
    "./game": {
      "types": "./dist/game/index.d.ts",
      "default": "./dist/game/index.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "default": "./dist/image/index.js"
    },
    "./lottie": {
      "types": "./dist/lottie/index.d.ts",
      "default": "./dist/lottie/index.js"
    },
    "./sprite-animation": {
      "types": "./dist/sprite-animation/index.d.ts",
      "default": "./dist/sprite-animation/index.js"
    },
    "./texture": {
      "types": "./dist/texture/index.d.ts",
      "default": "./dist/texture/index.js"
    },
    "./turf": {
      "types": "./dist/turf/index.d.ts",
      "default": "./dist/turf/index.js"
    },
    "./web-animation": {
      "types": "./dist/web-animation/index.d.ts",
      "default": "./dist/web-animation/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:core && pnpm clean:root && tsc -p tsconfig.build.json",
    "build:core": "pnpm --dir packages/core build",
    "build:watch": "pnpm build:core && pnpm --recursive --parallel --include-workspace-root --filter @driftee/dstjs-core --filter @driftee/dstjs run watch:self",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "clean": "pnpm clean:root && pnpm --dir packages/core clean",
    "clean:root": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "pnpm build:core && tsx src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "pnpm check",
    "test": "pnpm build:core && vitest run",
    "typecheck": "pnpm build:core && pnpm --dir packages/core typecheck && tsc --noEmit",
    "watch:self": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@driftee/dstjs-core": "^0.1.0",
    "decode-dxt": "1.0.1",
    "fast-xml-parser": "5.11.0",
    "gettext-parser": "9.1.1",
    "sharp": "0.35.3",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/decode-dxt": "1.0.3",
    "@types/gettext-parser": "8.0.0",
    "@types/node": "^22.0.0",
    "@types/yauzl": "2.10.3",
    "eslint": "9.39.2",
    "tsx": "4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
