{
  "name": "@driftee/dstjs-canvas",
  "version": "0.1.0",
  "description": "A lightweight headless Canvas 2D renderer for DST.js web animations.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch:self": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@driftee/dstjs-core": "^0.2.0"
  }
}
